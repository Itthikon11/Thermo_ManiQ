# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง:  cp .env.example .env
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=thermo_maniq

# --- MySQL คลาวด์ (Render/production) ตั้ง DB_SSL=true ---
# localhost ไม่ต้องตั้ง (ปล่อยว่าง = ปิด SSL)
DB_SSL=false
# DB_SSL_CA=            # เนื้อ CA cert ถ้าผู้ให้บริการให้มา (ขึ้นบรรทัดใหม่ใช้ \n)
# DB_SSL_REJECT_UNAUTHORIZED=true

PORT=3001
CORS_ORIGIN=http://localhost:5180,http://localhost:5173

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

ADMIN_USERNAME=admin
ADMIN_PASSWORD=thermo123

# --- เข้าสู่ระบบด้วย Google (Google Identity Services) ---
# OAuth 2.0 Client ID จาก Google Cloud Console (ต้องตรงกับ VITE_GOOGLE_CLIENT_ID ฝั่ง frontend)
GOOGLE_CLIENT_ID=
# อีเมลที่ให้สิทธิ์ "admin" เมื่อล็อกอินด้วย Google (คั่นด้วย ,) · '*' = ทุกคนเป็น admin
# ว่างไว้ = ล็อกอิน Google ได้ทุกคนแต่เป็น "ผู้ใช้ทั่วไป" (เข้าแผงแอดมินไม่ได้)
ALLOWED_GOOGLE_EMAILS=
